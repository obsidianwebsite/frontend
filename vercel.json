{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "outputDirectory": "dist/obsidian-trust-bank-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-9cmi.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
